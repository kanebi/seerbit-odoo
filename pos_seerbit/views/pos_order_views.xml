<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit POS Order Form View -->
    <record id="view_pos_pos_form_inherit_seerbit" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.seerbit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <!-- Add columns to the payments list inside POS Order -->
            <xpath expr="//field[@name='payment_ids']/list/field[@name='amount']" position="before">
                <field name="transaction_id" optional="show" string="Reference"/>
                <field name="seerbit_payer_name" optional="show" string="Payer Name"/>
                <field name="seerbit_va_transaction_id" optional="hide" string="VA Transaction"/>
            </xpath>

            <!-- Add SeerBit Bank Transfer Info to the Payments page -->
            <xpath expr="//field[@name='payment_ids']" position="after">
                <group string="SeerBit Bank Transfer Details" 
                       invisible="not seerbit_transaction_ref and not seerbit_va_transaction_id"
                       class="mt-3">
                    <group>
                        <field name="seerbit_transaction_ref" readonly="1"/>
                        <field name="seerbit_payer_name" readonly="1"/>
                    </group>
                    <group>
                        <field name="seerbit_amount_received" readonly="1"/>
                        <field name="seerbit_va_transaction_id" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit POS Payment Form View -->
    <record id="view_pos_payment_form_inherit_seerbit" model="ir.ui.view">
        <field name="name">pos.payment.form.inherit.seerbit</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='transaction_id']" position="after">
                <field name="seerbit_transaction_ref" invisible="not seerbit_transaction_ref"/>
                <field name="seerbit_payer_name" invisible="not seerbit_payer_name"/>
                <field name="seerbit_va_transaction_id" invisible="not seerbit_va_transaction_id"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit POS Payment List View -->
    <record id="view_pos_payment_tree_inherit_seerbit" model="ir.ui.view">
        <field name="name">pos.payment.list.inherit.seerbit</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="before">
                <field name="transaction_id" optional="show" string="Reference"/>
                <field name="seerbit_payer_name" optional="show" string="Payer Name"/>
            </xpath>
        </field>
    </record>
</odoo>
