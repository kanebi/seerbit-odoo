<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_seerbit_dashboard" model="ir.actions.client">
        <field name="name">Merchant Dashboard</field>
        <field name="tag">seerbit_dashboard</field>
    </record>

    <menuitem id="menu_seerbit_root" name="Seerbit" sequence="45" web_icon="pos_seerbit,static/description/icon.png"/>
    <menuitem id="menu_seerbit_dashboard" name="Merchant Dashboard" parent="menu_seerbit_root" action="action_seerbit_dashboard" sequence="10"/>
    <menuitem id="menu_seerbit_payouts" name="Payouts" parent="menu_seerbit_root" action="action_seerbit_payout" sequence="20"/>
    <menuitem id="menu_seerbit_virtual_accounts" name="Virtual Accounts" parent="menu_seerbit_root" action="action_seerbit_virtual_account" sequence="30"/>
    <menuitem id="menu_seerbit_payment_links" name="Payment Links" parent="menu_seerbit_root" action="action_pos_seerbit_payment_link" sequence="40"/>

    <record id="action_seerbit_invoices" model="ir.actions.act_window">
        <field name="name">Seerbit Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('seerbit_invoice_no', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>
    <menuitem id="menu_seerbit_invoices" name="Invoices" parent="menu_seerbit_root" action="action_seerbit_invoices" sequence="50"/>
    <record id="action_seerbit_terminals" model="ir.actions.act_window">
        <field name="name">Payment Terminals</field>
        <field name="res_model">pos.payment.method</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('use_payment_terminal', '=', 'seerbit')]</field>
        <field name="context">{'default_use_payment_terminal': 'seerbit', 'default_name': 'Seerbit Terminal'}</field>
    </record>
    <menuitem id="menu_seerbit_terminals" name="Payment Terminals" parent="menu_seerbit_root" action="action_seerbit_terminals" sequence="60"/>
    
    <menuitem id="menu_seerbit_settings" name="Configuration" parent="menu_seerbit_root" action="action_pos_seerbit_config_settings" sequence="100"/>
</odoo>
