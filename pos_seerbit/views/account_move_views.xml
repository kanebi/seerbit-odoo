<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_seerbit_inherit" model="ir.ui.view">
        <field name="name">account.move.form.seerbit.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sync_seerbit_invoice" type="object" string="Sync with Seerbit" class="oe_highlight" invisible="move_type != 'out_invoice' or state != 'posted' or synced_with_seerbit"/>
                <button name="action_check_seerbit_status" type="object" string="Check Seerbit Status" invisible="move_type != 'out_invoice' or not synced_with_seerbit"/>
                <button name="action_sync_seerbit_invoice" type="object" string="Update Seerbit" invisible="move_type != 'out_invoice' or not synced_with_seerbit"/>
                <button name="action_send_payment_to_pos" type="object" string="Send Payment to POS" invisible="move_type != 'out_invoice' or state != 'posted' or payment_state in ('in_payment', 'paid')"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="synced_with_seerbit" readonly="1"/>
                <field name="seerbit_invoice_no" readonly="1" invisible="not synced_with_seerbit"/>
                <field name="seerbit_invoice_status" readonly="1" invisible="not synced_with_seerbit"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="seerbit_payment_links" string="Seerbit Payment Links" invisible="move_type != 'out_invoice'">
                    <field name="seerbit_payment_link_ids">
                        <list string="Seerbit Payment Links" editable="bottom">
                            <field name="name"/>
                            <field name="description"/>
                            <field name="amount"/>
                            <field name="create_date" readonly="1"/>
                            <field name="seerbit_link_id" readonly="1"/>
                            <field name="link_url" widget="url" readonly="1"/>
                            <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'pending'" readonly="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
