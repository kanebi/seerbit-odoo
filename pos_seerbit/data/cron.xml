<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_spool_seerbit_payments" model="ir.cron">
            <field name="name">Seerbit: Spool Virtual Account Payments</field>
            <field name="model_id" ref="pos_seerbit.model_seerbit_virtual_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_spool_seerbit_payments()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_check_seerbit_invoice_status" model="ir.cron">
            <field name="name">Seerbit: Check Invoice Statuses</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.action_check_all_seerbit_status()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
