<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_seerbit.SeerbitIncomingPaymentsPopup">
        <Dialog size="'xl'" header="false" footer="false" withBodyPadding="false" contentClass="'seerbit-incoming-modal-content p-0'">
            <div class="seerbit-incoming-payments-modal d-flex flex-column bg-white">
                
                <!-- Slim Top Header (Replaces unneeded native Odoo header) -->
                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom bg-light">
                    <div class="d-flex align-items-center">
                        <img src="/pos_seerbit/static/description/seerbit_logo.png" 
                             onerror="this.src='/pos_seerbit/static/description/icon.png'" 
                             alt="SeerBit" 
                             class="me-2 rounded shadow-sm" 
                             style="height: 24px; width: auto; object-fit: contain;"/>
                        <span class="fs-6 fw-bolder text-dark">Select Bank Payment</span>
                    </div>
                    <button class="btn btn-close fs-6 p-1" aria-label="Close" t-on-click="closePopup"/>
                </div>

                <div class="p-3 overflow-y-auto" style="max-height: calc(85vh - 100px);">
                    <!-- Partially Matched Banner -->
                    <div t-if="state.isPartiallyMatched" class="alert alert-info py-2 px-3 mb-2 rounded-3 border-0 shadow-sm d-flex align-items-center justify-content-between">
                        <div>
                            <i class="fa fa-adjust me-2 text-primary"/>
                            <span class="fw-bold">Partially Matched: <t t-esc="formatAmount(state.settledAmount)"/> settled.</span>
                            <span class="ms-2">Balance required to complete: <strong><t t-esc="formatAmount(expectedAmount)"/></strong></span>
                        </div>
                        <span class="badge rounded-pill bg-primary text-white px-2 py-1">
                            Partial<t t-if="lineMatchedCount &gt; 1"> (<t t-esc="lineMatchedCount"/>)</t>
                        </span>
                    </div>

                    <!-- Top Summary & Refresh -->
                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded border">
                        <div>
                            <span class="small fw-bold" style="color: #374151;">Account:</span>
                            <strong class="font-monospace fs-6 text-dark ms-1"><t t-esc="props.accountNumber"/></strong>
                            <span class="small fw-bold ms-3" style="color: #374151;">Amount Needed:</span>
                            <strong class="text-success fs-6 ms-1"><t t-esc="formatAmount(expectedAmount)"/></strong>
                        </div>
                        <div>
                            <button class="btn btn-primary btn-sm px-3 py-1 fw-bold shadow-sm"
                                    t-att-disabled="state.syncing"
                                    t-on-click="syncLiveFromSeerbit">
                                <i t-attf-class="fa #{state.syncing ? 'fa-spinner fa-spin' : 'fa-refresh'} me-1"/>
                                <t t-if="state.syncing">Checking...</t>
                                <t t-else="">Refresh</t>
                            </button>
                        </div>
                    </div>

                    <!-- Search -->
                    <div class="input-group mb-2">
                        <span class="input-group-text py-1"><i class="fa fa-search" style="color: #374151;"/></span>
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="Search by customer name, reference, or amount..."
                               t-model="state.searchQuery"/>
                    </div>

                    <!-- Navigation Tabs: Till Payment (default) vs All Payments -->
                    <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" 
                                    t-attf-class="btn fw-bold px-3 py-1 #{state.activePaymentTab === 'till' ? 'text-white shadow-sm' : 'btn-outline-secondary'}"
                                    t-attf-style="#{state.activePaymentTab === 'till' ? 'background-color: #EB3E25 !important; border-color: #EB3E25 !important; color: #ffffff !important;' : ''}"
                                    t-on-click="() => this.setPaymentTab('till')">
                                <i class="fa fa-desktop me-1"/> Till Payment
                                <span t-if="state.payments.length" class="badge rounded-pill bg-light text-dark ms-1">
                                    <t t-esc="state.payments.length"/>
                                </span>
                            </button>
                            <button type="button" 
                                    t-attf-class="btn fw-bold px-3 py-1 #{state.activePaymentTab === 'all' ? 'text-white shadow-sm' : 'btn-outline-secondary'}"
                                    t-attf-style="#{state.activePaymentTab === 'all' ? 'background-color: #EB3E25 !important; border-color: #EB3E25 !important; color: #ffffff !important;' : ''}"
                                    t-on-click="() => this.setPaymentTab('all')">
                                <i class="fa fa-cubes me-1"/> All Payments
                                <span t-if="state.allPayments.length" class="badge rounded-pill bg-light text-dark ms-1">
                                    <t t-esc="state.allPayments.length"/>
                                </span>
                            </button>
                        </div>
                    </div>

                    <!-- Main Payments Content Area: Left Sidebar (Till PM Boxed Cards when in 'All Payments' mode) + Right Payments Table -->
                    <div class="d-flex flex-grow-1 gap-2 overflow-hidden" style="min-height: 360px; max-height: 420px;">
                        
                        <!-- Till PM Boxed Cards Sidebar (Parent Scrollable Vertical Component on Left) -->
                        <div t-if="state.activePaymentTab === 'all'" 
                             class="d-flex flex-column bg-light rounded-3 border p-1.5 overflow-y-auto flex-shrink-0 shadow-sm seerbit-till-pm-sidebar" 
                             style="width: 155px; min-width: 140px; max-width: 170px; max-height: 420px;">
                            
                            <div class="d-flex align-items-center justify-content-between mb-1 pb-1 border-bottom px-1">
                                <span class="small fw-bolder text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    <i class="fa fa-filter me-1 text-danger"/> Till PM
                                </span>
                                <span class="badge rounded bg-secondary text-white" style="font-size: 0.65rem;">
                                    <t t-esc="(state.tillPms ? state.tillPms.length : 0) + 1"/>
                                </span>
                            </div>

                            <div class="d-flex flex-column gap-1">
                                <!-- "All" Small Box Card -->
                                <button type="button" 
                                        t-attf-class="btn btn-sm text-start p-1.5 rounded-2 border w-100 transition-all #{state.selectedTillPmFilter === null ? 'text-white shadow-sm' : 'btn-light bg-white text-dark border-secondary-subtle'}"
                                        t-attf-style="#{state.selectedTillPmFilter === null ? 'background-color: #EB3E25 !important; border-color: #EB3E25 !important; color: #ffffff !important;' : ''}"
                                        t-on-click="() => this.filterByTillPm(null)">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="fw-bold text-truncate" style="font-size: 0.74rem;">All Tills</div>
                                        <span t-if="state.allPayments and state.allPayments.length" 
                                              t-attf-class="badge rounded-pill #{state.selectedTillPmFilter === null ? 'bg-white text-dark' : 'bg-secondary text-white'} ms-1" 
                                              style="font-size: 0.62rem;">
                                            <t t-esc="state.allPayments.length"/>
                                        </span>
                                    </div>
                                    <div class="text-truncate small opacity-75" style="font-size: 0.66rem;">All payment methods</div>
                                </button>

                                <!-- Each Till PM Small Box Card Following Another Vertically -->
                                <t t-foreach="state.tillPms" t-as="tpm" t-key="tpm.key || (tpm.config_id ? (tpm.config_id + '_' + tpm.id) : (tpm.id + '_' + tpm_index))">
                                    <button type="button" 
                                            t-attf-class="btn btn-sm text-start p-1.5 rounded-2 border w-100 transition-all #{state.selectedTillPmFilter === (tpm.key || tpm.id) ? 'text-white shadow-sm' : 'btn-light bg-white text-dark border-secondary-subtle'}"
                                            t-attf-style="#{state.selectedTillPmFilter === (tpm.key || tpm.id) ? 'background-color: #EB3E25 !important; border-color: #EB3E25 !important; color: #ffffff !important;' : ''}"
                                            t-att-title="tpm.label + (tpm.account_number ? (' - ' + tpm.account_number) : '')"
                                            t-on-click="() => this.filterByTillPm(tpm.key || tpm.id)">
                                        <div class="fw-bold text-truncate" style="font-size: 0.74rem; line-height: 1.2;">
                                            <t t-esc="tpm.config_name || 'Till'"/>
                                        </div>
                                        <div class="text-truncate opacity-75" style="font-size: 0.66rem; line-height: 1.2;" t-att-title="tpm.pm_name">
                                            <t t-esc="tpm.pm_name"/>
                                        </div>
                                        <div t-if="tpm.account_number" 
                                             class="text-truncate font-monospace fw-bold" 
                                             t-attf-style="font-size: 0.66rem; line-height: 1.25; margin-top: 1px; #{state.selectedTillPmFilter === (tpm.key || tpm.id) ? 'color: #ffffff !important;' : 'color: #714B67 !important;'}"
                                             t-att-title="tpm.account_number">
                                            <t t-esc="tpm.account_number"/>
                                        </div>
                                    </button>
                                </t>
                            </div>
                        </div>

                        <!-- Right Column: Active Till Badge (on All Payments screen) + Payments Table -->
                        <div class="d-flex flex-column flex-grow-1 overflow-hidden" style="min-width: 0;">
                            <!-- Active Till & PM Filter Badge on top of Table (Only in 'All Payments' screen) -->
                            <div t-if="state.activePaymentTab === 'all'" class="d-flex align-items-center justify-content-between mb-2 py-1 px-2 rounded bg-light border flex-shrink-0">
                                <div class="d-flex align-items-center text-truncate">
                                    <span class="small text-muted me-1 fw-semibold" style="font-size: 0.72rem;">Active Till &amp; PM:</span>
                                    <span class="badge text-white px-2 py-1 fw-bold shadow-sm text-truncate" style="background-color: #EB3E25; font-size: 0.72rem;">
                                        <i class="fa fa-desktop me-1"/>
                                        <t t-esc="selectedTillPmLabel"/>
                                    </span>
                                </div>
                                <span class="small text-muted flex-shrink-0 ms-2" style="font-size: 0.7rem;">
                                    Showing <strong class="text-dark"><t t-esc="filteredPayments.length"/></strong> payments
                                </span>
                            </div>

                            <!-- Payments Table / List -->
                        <div class="table-responsive" style="max-height: 360px; overflow-y: auto;">
                        <t t-if="state.loading">
                            <div class="text-center py-4">
                                <i class="fa fa-circle-o-notch fa-spin fa-2x text-primary mb-2"/>
                                <div class="fw-bold" style="color: #374151;">Checking payments...</div>
                            </div>
                        </t>
                        <t t-elif="!filteredPayments.length">
                            <div class="text-center py-4" style="color: #374151;">
                                <i class="fa fa-inbox fa-2x mb-2" style="color: #4b5563;"/>
                                <div class="fs-6 fw-bold text-dark">No bank transfers found yet.</div>
                                <div class="small mt-1" style="color: #374151;">If the customer has already transferred, click <strong>Refresh</strong> above.</div>
                            </div>
                        </t>
                        <t t-else="">
                            <table class="table table-hover table-sm align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="color: #1f2937;">Time</th>
                                                                                <th style="color: #1f2937;">Sender Name</th>
                                        <th style="color: #1f2937;">Amount</th>
                                        <th style="color: #1f2937;">Reference</th>
                                        <th style="color: #1f2937;">Status</th>
                                        <th class="text-end" style="color: #1f2937;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="filteredPayments" t-as="p" t-key="p.id ? (p.id + '_' + p_index) : p_index"
                                        t-att-class="{'table-secondary opacity-50': p.matching_status === 'transferred', 'table-success': isExactAmount(p.amount) and p.matching_status !== 'transferred'}">
                                        <td class="small fw-semibold" style="color: #374151;"><t t-esc="formatDate(p.payment_date)"/></td>
                                        <td>
                                            <strong class="small text-dark"><t t-esc="p.payer_name"/></strong>
                                            <span t-if="p.is_transferred_in" class="badge bg-info text-dark ms-1 small">
                                                <i class="fa fa-arrow-down me-1"/>Transferred In
                                            </span>
                                        </td>
                                        <td>
                                            <span class="small fw-bold text-dark"><t t-esc="formatAmount(p.amount)"/></span>
                                            <span t-if="isExactAmount(p.amount) and p.matching_status !== 'transferred'" class="badge bg-success ms-1 small fw-bold">Exact Match</span>
                                            <span t-if="p.has_duplicate_amount and p.matching_status !== 'transferred'" class="badge text-bg-warning ms-1 small fw-bold" title="Multiple payments of same amount - manual match required">Duplicate Amount</span>
                                        </td>
                                        <td class="font-monospace small fw-semibold" style="color: #374151;"><t t-esc="p.reference"/></td>
                                        <td>
                                            <t t-if="p.matching_status === 'transferred'">
                                                <span class="badge bg-secondary text-white">
                                                    <i class="fa fa-share me-1"/>Transferred to <t t-esc="p.transferred_to_config_name || 'Till'"/>
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-success">Received</span>
                                            </t>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <t t-if="p.matching_status === 'transferred'">
                                                <span class="text-muted small fst-italic me-2">Transferred</span>
                                            </t>
                                            <t t-else="">
                                                <button class="btn btn-outline-secondary btn-sm px-2 py-1 me-1 fw-bold"
                                                        title="Transfer to another Till / Register"
                                                        t-on-click="() => this.openTransferToTill(p)">
                                                    <i class="fa fa-share me-1"/>Till
                                                </button>
                                                <button class="btn btn-success btn-sm px-2 py-1 fw-bold"
                                                        t-on-click="() => this.selectPayment(p)">
                                                    <i class="fa fa-check me-1"/> Select
                                                </button>
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                        </div>
                    </div>
                
                </div>

                <!-- Footer with Smaller Buttons -->
                <div class="modal-footer d-flex justify-content-end align-items-center px-3 py-2 border-top bg-light">
                    <button class="btn btn-sm btn-dark px-3 py-1 fw-bold shadow-sm seerbit-btn-dark" style="background-color: #1f2937 !important; color: #ffffff !important; border-color: #1f2937 !important;" t-on-click="props.close">
                        <span style="color: #ffffff !important;">Close</span>
                    </button>
                </div>

                <!-- Inter-Till Transfer Modal Overlay -->
                <t t-if="state.showTransferModal">
                    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex align-items-center justify-content-center p-3" style="z-index: 1060;">
                        <div class="card shadow-lg border-0 w-100" style="max-width: 520px; border-radius: 12px; overflow: hidden;">
                            <div class="card-header bg-primary text-white py-2 px-3 d-flex justify-content-between align-items-center">
                                <span class="fw-bold"><i class="fa fa-share me-1"/> Transfer Payment to Another Till</span>
                                <button type="button" class="btn-close btn-close-white btn-sm" t-on-click="closeTransferModal"/>
                            </div>
                            <div class="card-body p-3 text-start">
                                <div class="alert alert-light border mb-3 py-2 px-3 small">
                                    <div>Payment Amount: <strong class="text-success"><t t-esc="formatAmount(state.transferPaymentTarget?.amount)"/></strong></div>
                                    <div>Customer: <strong><t t-esc="state.transferPaymentTarget?.payer_name"/></strong></div>
                                    <div class="text-muted">Ref: <span class="font-monospace"><t t-esc="state.transferPaymentTarget?.reference"/></span></div>
                                </div>

                                <div class="fw-bold text-dark small mb-2">Select Destination Till / Register:</div>

                                <t t-if="state.loadingTills">
                                    <div class="text-center py-4">
                                        <div class="spinner-border text-primary spinner-border-sm me-2" role="status"/>
                                        <span class="text-muted small">Loading available tills...</span>
                                    </div>
                                </t>
                                <t t-elif="!state.availableTills.length">
                                    <div class="text-center py-3 text-muted small">
                                        <i class="fa fa-exclamation-circle me-1 text-warning"/> No other tills with SeerBit transfer found.
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="list-group mb-3" style="max-height: 200px; overflow-y: auto;">
                                        <button t-foreach="state.availableTills" t-as="till" t-key="till.id ? (till.id + '_' + till_index) : till_index"
                                                type="button"
                                                class="list-group-item list-group-item-action py-2 px-3 d-flex justify-content-between align-items-center"
                                                t-att-class="{'active text-white': state.selectedTargetTillId === till.id}"
                                                t-on-click="() => this.selectTargetTill(till)">
                                            <div>
                                                <div class="fw-bold"><t t-esc="till.name"/></div>
                                                <div class="small opacity-75">
                                                    <t t-if="till.is_open">
                                                        <span class="badge bg-success me-1">Open Session</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-secondary me-1">Closed</span>
                                                    </t>
                                                    <t t-if="till.payment_methods and till.payment_methods.length">
                                                        <span>VA: <t t-esc="till.payment_methods[0].account_number"/> (<t t-esc="till.payment_methods[0].bank_name"/>)</span>
                                                    </t>
                                                </div>
                                            </div>
                                            <i t-if="state.selectedTargetTillId === till.id" class="fa fa-check-circle fs-5"/>
                                        </button>
                                    </div>

                                    <!-- If multiple payment methods on selected till -->
                                    <t t-set="selectedTillObj" t-value="state.availableTills.find(t => t.id === state.selectedTargetTillId)"/>
                                    <t t-if="selectedTillObj and selectedTillObj.payment_methods.length > 1">
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Select Transfer Method:</label>
                                            <select class="form-select form-select-sm" t-model="state.selectedTargetPmId">
                                                <option t-foreach="selectedTillObj.payment_methods" t-as="pm" t-key="pm.id ? (pm.id + '_' + pm_index) : pm_index" t-att-value="pm.id">
                                                    <t t-esc="pm.name"/> (<t t-esc="pm.account_number"/> - <t t-esc="pm.bank_name"/>)
                                                </option>
                                            </select>
                                        </div>
                                    </t>
                                </t>
                            </div>
                            <div class="card-footer bg-light py-2 px-3 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary btn-sm px-3" t-on-click="closeTransferModal" t-att-disabled="state.transferringPayment">
                                    Cancel
                                </button>
                                <button type="button" class="btn btn-primary btn-sm px-3 fw-bold"
                                        t-att-disabled="!state.selectedTargetTillId or state.transferringPayment"
                                        t-on-click="confirmTransferToTill">
                                    <i t-if="state.transferringPayment" class="fa fa-spinner fa-spin me-1"/>
                                    <i t-else="" class="fa fa-share me-1"/>
                                    <t t-if="state.transferringPayment">Transferring...</t>
                                    <t t-else="">Confirm Transfer</t>
                                </button>
                            </div>
                        </div>
                    </div>
                </t>

            </div>
        </Dialog>
    </t>
</templates>