<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="SeerbitPaymentScreenPaymentLines"
       t-inherit="point_of_sale.PaymentScreenPaymentLines"
       
       t-inherit-mode="extension"
       owl="1">

        <!-- Match the exact structure in Odoo 18 -->
           <xpath expr="//div[contains(@t-attf-class, 'electronic_payment')]" position="inside">


            <!-- Seerbit: Waiting for payment -->
            <t t-if="line.payment_status == 'waitingSeerbit'">
                <div class="electronic_status waiting" aria-live="polite">
                    <span class="seerbit-icon" aria-hidden="true">
                        <i class="fa fa-hourglass-half"/>
                    </span>
                    <span>Waiting for Terminal Payment</span>
                </div>
                <div class="seerbit-buttons">
                    <div class="button send_force_done dangerous"
                         title="Force Done"
                         aria-label="Force Confirm"
                         t-on-click="() => this.props.sendForceDone(line)">
                        <i class="fa fa-bolt seerbit-icon" aria-hidden="true"/> Force Confirm
                    </div>
                    <div class="button send_payment_request highlight"
                         title="Retry Payment Request"
                         aria-label="Retry Payment Request"
                         t-on-click="() => this.props.sendPaymentRequest(line)">
                        <i class="fa fa-repeat seerbit-icon" aria-hidden="true"/> Retry
                    </div>
                </div>
            </t>

            <!-- Seerbit: Error -->
            <t t-elif="line.payment_status == 'errorSeerbit'">
                <div class="electronic_status error" aria-live="polite">
                    <span class="seerbit-icon" aria-hidden="true">
                        <i class="fa fa-exclamation-triangle"/>
                    </span>
                    <span>Error with Seerbit payment</span>
                </div>
                <div class="seerbit-buttons">
                    <div class="button send_force_done dangerous"
                         title="Force Done"
                         aria-label="Force Confirm"
                         
                         t-on-click="() => this.props.sendForceDone(line)">
                        <i class="fa fa-bolt seerbit-icon" aria-hidden="true"/> Force Confirm
                    </div>
                    <div class="button send_payment_request highlight"
                         title="Retry Payment Request"
                         aria-label="Retry Payment Request"
                         t-on-click="() => this.props.sendPaymentRequest(line)">
                        <i class="fa fa-repeat seerbit-icon" aria-hidden="true"/> Retry
                    </div>
                </div>
            </t>

        </xpath>
    </t>
</templates>
