<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_seerbit.SeerbitVaModalPopup">
        <Dialog size="'xl'" header="false" footer="false" withBodyPadding="false" contentClass="'seerbit-va-modal-content p-0'">
            <div class="seerbit-modal-wrapper d-flex flex-column h-100 bg-white">
                
                <!-- Modal Top Header (Spacious padding, Store Account moved to far right) -->
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom bg-light">
                    <!-- Left: Seerbit Logo & Title -->
                    <div class="d-flex align-items-center">
                        <img src="/pos_seerbit/static/description/seerbit_logo.png" 
                             onerror="this.src='/pos_seerbit/static/description/icon.png'" 
                             alt="SeerBit" 
                             class="me-3 rounded shadow-sm" 
                             style="height: 32px; width: auto; object-fit: contain;"/>
                        <span class="fs-5 fw-bolder text-dark mb-0">Bank Transfer Payment</span>
                    </div>

                    <!-- Right: Store/Order Account Badge on far right, Countdown & Close -->
                    <div class="d-flex align-items-center gap-2">
                        <span t-if="isDynamic" class="badge bg-warning text-dark fw-bold px-3 py-1 fs-6 shadow-sm">Order Account</span>
                        <span t-else="" class="badge text-white fw-bold px-3 py-1 fs-6 shadow-sm" style="background-color: #1E293B; color: #ffffff !important;">Store Account</span>

                        <span t-if="isDynamic and hasGeneratedDynamicVa" 
                              t-attf-class="badge #{state.isExpired ? 'bg-danger text-white' : (state.remainingSeconds &lt; 300 ? 'bg-danger text-white' : 'seerbit-countdown-badge text-white')} fw-bold px-3 py-1 fs-6 shadow-sm">
                            <i t-attf-class="fa #{state.isExpired ? 'fa-times-circle' : 'fa-clock-o'} me-1"/>
                            <t t-if="state.isExpired">Expired</t>
                            <t t-else=""><t t-esc="formattedCountdown"/></t>
                        </span>
                        <button class="btn btn-close fs-6 p-2 ms-2" aria-label="Close" t-on-click="_closeModal"/>
                    </div>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4 flex-grow-1 d-flex flex-column justify-content-center overflow-y-auto" style="background-color: #F8FAFC;">
                    
                    <!-- Success / Confirmed State -->
                    <t t-if="state.isSuccess">
                        <div class="card p-5 border-0 shadow rounded-4 bg-white text-center my-auto mx-auto" style="max-width: 520px;">
                            <div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-circle mx-auto shadow-sm" style="width: 80px; height: 80px; background-color: #DEF7EC;">
                                <i class="fa fa-check fa-3x text-success"/>
                            </div>
                            <h3 class="fw-bolder text-dark mb-1">Payment Received!</h3>
                            <p class="fs-6 text-muted mb-4">
                                Bank transfer confirmed from <strong class="text-dark"><t t-esc="state.successData?.payer_name || 'Bank Customer'"/></strong>
                            </p>

                            <!-- Success Details Box -->
                            <div class="p-3 mb-4 rounded-3 text-start shadow-sm" style="background-color: #F8FAFC; border: 1px solid #E2E8F0;">
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-muted small fw-semibold">Amount Received:</span>
                                    <span class="fw-bolder text-success fs-5"><t t-esc="formatAmount(state.successData?.amount || expectedAmount)"/></span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-muted small fw-semibold">Account Number:</span>
                                    <span class="fw-bold font-monospace text-dark"><t t-esc="accountNumber"/></span>
                                </div>
                                <div t-if="state.successData?.reference" class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-muted small fw-semibold">Reference:</span>
                                    <span class="small font-monospace text-secondary"><t t-esc="state.successData.reference"/></span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2">
                                    <span class="text-muted small fw-semibold">Status:</span>
                                    <span class="badge bg-success fw-bold px-2 py-1"><i class="fa fa-check me-1"/>Verified &amp; Matched</span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-center gap-3">
                                <span class="text-muted small">
                                    <i class="fa fa-clock-o me-1"/> Closing in <strong><t t-esc="state.successCountdown"/>s</strong>...
                                </span>
                                <button class="btn btn-success fw-bold px-4 py-2 shadow-sm rounded-pill" t-on-click="_finishSuccess">
                                    <i class="fa fa-check me-1"/> Done
                                </button>
                            </div>
                        </div>
                    </t>

                    <!-- Pre-Generation State for Dynamic VA -->
                    <t t-elif="isDynamic and !hasGeneratedDynamicVa">
                        <div class="card p-5 border-0 shadow-sm rounded-4 bg-white text-center my-auto">
                            <div class="mb-3">
                                <i class="fa fa-university fa-4x" style="color: #EB3E25;"/>
                            </div>
                            <h3 class="fw-bolder text-dark mb-2">Generate Bank Account for this Order</h3>
                            <p class="fs-6 mb-4" style="color: #4B5563 !important;">
                                A unique virtual bank account will be created on SeerBit for this transaction.
                            </p>

                            <!-- Current Due Amount Box -->
                            <div class="p-4 mx-auto mb-4 rounded-4 shadow-sm" style="max-width: 420px; border: 2px solid #FCD5CE; background: #FFF9F8;">
                                <div class="small fw-bolder text-uppercase" style="color: #64748B; letter-spacing: 1px;">TRANSFER AMOUNT</div>
                                <div class="display-4 fw-bolder font-monospace my-2" style="color: #EB3E25;">
                                    <t t-esc="expectedAmountFormatted"/>
                                </div>
                            </div>

                            <!-- Loading Spinner when Generating -->
                            <div t-if="state.generatingDynamicVa" class="p-3">
                                <div class="spinner-border mb-2" style="width: 2.5rem; height: 2.5rem; color: #EB3E25;" role="status"/>
                                <div class="fs-6 fw-bold text-dark">Connecting to SeerBit...</div>
                            </div>

                            <!-- Error Message -->
                            <div t-elif="state.error" class="alert alert-danger p-3 mb-3 mx-auto" style="max-width: 450px;">
                                <div class="fw-bold text-danger mb-1">Failed to generate account:</div>
                                <div class="small mb-2"><t t-esc="state.error"/></div>
                                <button class="btn btn-outline-danger btn-sm fw-bold px-3" t-on-click="generateDynamicVa">
                                    <i class="fa fa-repeat me-1"/> Try Again
                                </button>
                            </div>

                            <!-- Generate Button -->
                            <div t-else="" class="mx-auto" style="max-width: 420px;">
                                <button class="btn seerbit-btn-primary btn-lg w-100 py-3 fw-bolder fs-5 rounded-pill shadow"
                                        t-on-click="generateDynamicVa">
                                    <i class="fa fa-university me-2"/> Generate Bank Account
                                </button>
                            </div>
                        </div>
                    </t>

                    <!-- Generated Dynamic VA OR Static VA Available -->
                    <t t-else="">
                        <!-- Expired Notice (if expired) -->
                        <div t-if="isDynamic and state.isExpired" class="alert alert-danger py-2 px-3 mb-3 rounded-3 border-0 shadow-sm text-center">
                            <div class="fs-6 fw-bolder text-danger mb-1">
                                <i class="fa fa-times-circle me-1"/> Bank Account Expired (30 Min Timeout)
                            </div>
                            <div class="small fw-semibold text-dark">
                                Transfer window closed. Click "Generate New Account" below.
                            </div>
                        </div>

                        <!-- Normal Full View: 2 Cards Side by Side (when NOT showing payment list) -->
                        <t t-if="!state.showPaymentsList">
                            <div class="row g-4 align-items-stretch flex-grow-1 seerbit-cards-row">
                                
                                <!-- LEFT CARD: Amount to Transfer (Cozy Green Emerald Theme) -->
                                <div class="col-12 col-md-5 d-flex flex-column">
                                    <div class="card h-100 p-4 seerbit-amount-card d-flex flex-column justify-content-center text-center">
                                        <div class="my-auto">
                                            <div class="small fw-bolder text-uppercase" style="color: #166534; letter-spacing: 1.5px;">AMOUNT TO TRANSFER</div>
                                            <div class="display-3 fw-bolder font-monospace my-3 text-truncate" style="color: #15803D; letter-spacing: -1px;">
                                                <t t-esc="expectedAmountFormatted"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- RIGHT CARD: Bank Account Card (Cozy Warm Slate, Bank Name on Far Right) -->
                                <div class="col-12 col-md-7 d-flex flex-column">
                                    <div class="card h-100 p-4 seerbit-bank-card d-flex flex-column justify-content-between"
                                         t-att-style="state.isExpired ? 'opacity: 0.55;' : ''">
                                        
                                        <!-- Top Row: Account Number Label on Left, Bank Name on Far Right with Seerbit icon -->
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="small fw-bolder text-uppercase" style="color: #64748B; letter-spacing: 1px;">ACCOUNT NUMBER</span>
                                            <div class="d-flex align-items-center fw-bolder fs-5 text-truncate" style="color: #0F172A;" t-att-title="bankName">
                                                <i class="fa fa-university me-2" style="color: #EB3E25;"/>
                                                <span><t t-esc="bankName"/></span>
                                            </div>
                                        </div>

                                        <!-- Center: Massive Account Number (no copy button) -->
                                        <div class="my-auto py-2">
                                            <div t-attf-class="display-2 fw-bolder font-monospace text-truncate #{state.isExpired ? 'text-decoration-line-through' : ''}" 
                                                 style="letter-spacing: 4px; user-select: all; color: #0F172A;">
                                                <t t-esc="accountNumber"/>
                                            </div>
                                        </div>

                                        <!-- Bottom Row: Account Name -->
                                        <div class="pt-3 border-top mt-3 text-start" style="border-color: #E2E8F0 !important;">
                                            <div class="small fw-bolder text-uppercase" style="color: #64748B; letter-spacing: 0.5px;">ACCOUNT NAME</div>
                                            <div class="fs-4 fw-bold mt-1 text-truncate" style="color: #1E293B;" t-att-title="accountName">
                                                <t t-esc="accountName"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <!-- Radiant SeerBit Logo-Color Loading Beacon (Zero redundant texts) -->
                            <div t-if="!state.isExpired" class="d-flex align-items-center justify-content-center py-2 mt-3">
                                <div class="seerbit-radiant-beacon">
                                    <span class="seerbit-beep-dot"></span>
                                    <span class="seerbit-beep-dot"></span>
                                    <span class="seerbit-beep-dot"></span>
                                </div>
                            </div>
                        </t>

                        <!-- Squeezed 30% / 70% Split Screen (When Check/Select Bank Payment is toggled open) -->
                        <t t-else="">
                            <div class="row g-3 h-100 flex-grow-1 align-items-stretch seerbit-split-container">
                                
                                <!-- LEFT 30%: Squeezed Vertical Stack of Amount and Bank Card -->
                                <div class="col-12 col-md-4 col-lg-3 d-flex flex-column gap-3 seerbit-squeeze-col">
                                    <!-- Squeezed Amount Card -->
                                    <div class="card p-3 rounded-3 seerbit-amount-card text-center">
                                        <div class="small fw-bolder text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px; color: #166534;">AMOUNT TO TRANSFER</div>
                                        <div class="fs-2 fw-bolder font-monospace my-1 text-truncate" style="color: #15803D;">
                                            <t t-esc="expectedAmountFormatted"/>
                                        </div>
                                    </div>

                                    <!-- Squeezed Bank Account Card -->
                                    <div class="card p-3 rounded-3 seerbit-bank-card flex-grow-1 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="small fw-bolder text-uppercase" style="font-size: 0.75rem; color: #64748B;">ACCOUNT NUMBER</div>
                                            <div class="fs-4 fw-bolder font-monospace text-truncate my-1" style="letter-spacing: 1px; user-select: all; color: #0F172A;">
                                                <t t-esc="accountNumber"/>
                                            </div>
                                        </div>
                                        <div class="py-2 border-top" style="border-color: #E2E8F0 !important;">
                                            <div class="small fw-bolder text-uppercase" style="font-size: 0.75rem; color: #64748B;">BANK</div>
                                            <div class="fs-6 fw-bolder text-truncate" style="color: #0F172A;">
                                                <i class="fa fa-university me-1" style="color: #EB3E25;"/> <t t-esc="bankName"/>
                                            </div>
                                        </div>
                                        <div class="pt-2 border-top" style="border-color: #E2E8F0 !important;">
                                            <div class="small fw-bolder text-uppercase" style="font-size: 0.75rem; color: #64748B;">ACCOUNT NAME</div>
                                            <div class="small fw-bold text-truncate" style="color: #1E293B;" t-att-title="accountName">
                                                <t t-esc="accountName"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- RIGHT 70%: Payment List & Components (No redundant SeerBit logo) -->
                                <div class="col-12 col-md-8 col-lg-9 d-flex flex-column h-100 bg-white rounded-3 border p-3 shadow-sm seerbit-payments-list-col">
                                    
                                    <!-- Search & Refresh Toolbar -->
                                    <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                                        <div class="input-group input-group-sm flex-grow-1">
                                            <span class="input-group-text bg-light border-end-0"><i class="fa fa-search text-muted"/></span>
                                            <input type="text"
                                                   class="form-control border-start-0"
                                                   placeholder="Search by customer name, reference, or amount..."
                                                   t-model="state.paymentsSearchQuery"/>
                                        </div>
                                        <button class="btn btn-sm seerbit-btn-primary px-3 fw-bold shadow-sm flex-shrink-0"
                                                t-att-disabled="state.syncingPayments"
                                                t-on-click="syncLiveFromSeerbit">
                                            <i t-attf-class="fa #{state.syncingPayments ? 'fa-spinner fa-spin' : 'fa-refresh'} me-1"/>
                                            <t t-if="state.syncingPayments">Checking...</t>
                                            <t t-else="">Refresh</t>
                                        </button>
                                    </div>

                                    <!-- Payments Table (Scrollable) -->
                                    <div class="table-responsive flex-grow-1 border rounded" style="max-height: 380px; overflow-y: auto;">
                                        <t t-if="state.loadingPayments">
                                            <div class="text-center py-5">
                                                <div class="spinner-border mb-2" style="color: #EB3E25;" role="status"/>
                                                <div class="fw-bold text-muted">Checking incoming bank transfers...</div>
                                            </div>
                                        </t>
                                        <t t-elif="!filteredPayments.length">
                                            <div class="text-center py-5 text-muted">
                                                <i class="fa fa-inbox fa-3x mb-2 text-secondary"/>
                                                <div class="fs-6 fw-bold text-dark">No bank transfers found yet.</div>
                                                <div class="small mt-1">If customer has already transferred, click <strong>Refresh</strong> above.</div>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <table class="table table-hover table-sm align-middle mb-0">
                                                <thead class="table-light sticky-top">
                                                    <tr>
                                                        <th class="py-2 text-dark">Time</th>
                                                        <th class="py-2 text-dark">Sender Name</th>
                                                        <th class="py-2 text-dark">Amount</th>
                                                        <th class="py-2 text-dark">Reference</th>
                                                        <th class="py-2 text-dark">Status</th>
                                                        <th class="py-2 text-end text-dark">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr t-foreach="filteredPayments" t-as="p" t-key="p.id"
                                                        t-att-class="{'table-success': isExactAmount(p.amount)}">
                                                        <td class="small fw-semibold text-secondary"><t t-esc="formatDate(p.payment_date)"/></td>
                                                        <td>
                                                            <strong class="small text-dark"><t t-esc="p.payer_name"/></strong>
                                                        </td>
                                                        <td>
                                                            <span class="small fw-bold text-dark"><t t-esc="formatAmount(p.amount)"/></span>
                                                            <span t-if="isExactAmount(p.amount)" class="badge bg-success ms-1 small fw-bold">Exact Match</span>
                                                        </td>
                                                        <td class="font-monospace small text-secondary"><t t-esc="p.reference"/></td>
                                                        <td>
                                                            <span class="badge bg-success">Received</span>
                                                        </td>
                                                        <td class="text-end">
                                                            <button class="btn btn-success btn-sm px-3 py-1 fw-bold"
                                                                    t-on-click="() => this.selectPayment(p)">
                                                                <i class="fa fa-check me-1"/> Select
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </t>
                                    </div>
                                </div>

                            </div>
                        </t>

                    </t>
                </div>

                <!-- Modal Footer (Cozy theme, space-sustaining) -->
                <div t-if="!state.isSuccess" class="modal-footer d-flex justify-content-between align-items-center px-4 py-2 border-top bg-light">
                    <!-- Left: Change Amount (Dynamic only) -->
                    <div>
                        <button t-if="isDynamic and hasGeneratedDynamicVa and !state.isExpired" 
                                class="btn btn-sm btn-outline-secondary fw-bold px-3 py-1 shadow-sm"
                                style="color: #1F2937 !important; border-color: #94A3B8 !important;"
                                t-on-click="resetDynamicVa">
                            <i class="fa fa-undo me-1"/> Change Amount
                        </button>
                        <button t-elif="isDynamic and state.isExpired" 
                                class="btn btn-sm btn-danger fw-bold px-3 py-1 shadow-sm"
                                t-on-click="generateDynamicVa">
                            <i class="fa fa-refresh me-1"/> Generate New Account
                        </button>
                    </div>

                    <!-- Right: Seerbit Primary Toggle & Close -->
                    <div class="d-flex align-items-center gap-2">
                        <!-- Toggle Button (Check Payment / Back to Details) -->
                        <button t-if="hasGeneratedDynamicVa and state.showPaymentsList" 
                                class="btn btn-sm seerbit-btn-outline-primary fw-bold px-3 py-1 shadow-sm"
                                t-on-click="togglePaymentsList">
                            <i class="fa fa-arrow-left me-1"/> Back to Account View
                        </button>
                        <button t-elif="hasGeneratedDynamicVa" 
                                class="btn btn-sm seerbit-btn-primary fw-bold px-3 py-1 shadow-sm d-flex align-items-center"
                                t-on-click="togglePaymentsList">
                            <i class="fa fa-list-alt me-1"/>
                            <span>Check / Select Bank Payment</span>
                            <span t-if="state.unmatchedCount > 0" class="badge bg-white text-danger ms-1 fw-bold">
                                <t t-esc="state.unmatchedCount"/> new
                            </span>
                        </button>

                        <button class="btn btn-sm btn-dark fw-bold px-3 py-1 seerbit-btn-dark shadow-sm" 
                                style="background-color: #1F2937 !important; color: #ffffff !important; border-color: #1F2937 !important;"
                                t-on-click="_closeModal">
                            <span style="color: #ffffff !important;">Close</span>
                        </button>
                    </div>
                </div>

            </div>
        </Dialog>
    </t>
</templates>
